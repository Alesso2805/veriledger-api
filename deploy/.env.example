# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env, which git ignores, and fill in every value.

# The database; the API's DATABASE_URL is built from these three
POSTGRES_USER=veriledger
POSTGRES_PASSWORD=
POSTGRES_DB=veriledger

APP_ENV=production
APP_DEBUG=false
# Empty: behind Caddy the webapp shares the API's origin, so no other origin needs CORS (ADR-0005)
CORS_ORIGINS=
# Required: the API does not start without at least 32 random bytes, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The image tag to run: main, or a sha-<commit> to pin one build
API_IMAGE_TAG=main
# The webapp's image tag; pin a sha-<commit> as well, since its tags move with every push to its main
WEBAPP_IMAGE_TAG=main

# The hostname Caddy serves (VLA-27): a real domain gets Let's Encrypt; localhost, a rehearsal with Caddy's own CA
DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443

# The admin the migrate service creates once; required, since production refuses an empty or the development password
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Peers (VLA-19): the token every node of the network shares; empty, peers cannot call this node
PEER_TOKEN=
ALLOW_PRIVATE_PEERS=false

# The public demo (ADR-0006)
DEMO_MODE=false
DEMO_ACCOUNTS_PER_IP_PER_HOUR=5
DEMO_MAX_ACTIVE_ACCOUNTS=500
DEMO_MINES_PER_HOUR=10

# Abuse limits on every node (VLA-29); 0 or false turns one off
LOGIN_ATTEMPTS_PER_MINUTE=5
TRANSACTIONS_PER_SENDER_PER_MINUTE=60
MINE_ONE_AT_A_TIME=true
