# Database
POSTGRES_USER=veriledger
POSTGRES_PASSWORD=veriledger_pass
POSTGRES_DB=veriledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://veriledger:veriledger_pass@localhost:5432/veriledger

# App
APP_ENV=development
APP_DEBUG=true
# true opens POST /auth/demo, the one-click 24-hour trader accounts (ADR-0006)
DEMO_MODE=false
# The demo's limits (ADR-0006); 0 turns one off
DEMO_ACCOUNTS_PER_IP_PER_HOUR=5
DEMO_MAX_ACTIVE_ACCOUNTS=500
DEMO_MINES_PER_HOUR=10

# Mining: the same values on every node of one network (VLA-17)
MINING_DIFFICULTY=4
MINING_REWARD=50

# Security
SECRET_KEY=supersecretkey_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Peers: the token every node of one network shares (VLA-19); empty, peers cannot call this node
PEER_TOKEN=
# true lets peers sit on loopback, private and link-local addresses: development and private networks only
ALLOW_PRIVATE_PEERS=false
